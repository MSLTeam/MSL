                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Label Content="{Binding [SR_FormatLogHeader], Source={x:Static langs:LanguageManager.Instance}}" Style="{StaticResource MagicLabel14}"/>
                                            <ToggleButton x:Name="formatOutHead" IsChecked="True" Style="{StaticResource ToggleButtonSwitch.Content}" Click="formatOutHead_Click"/>
                                        </StackPanel>
                                        <hc:UniformSpacingPanel x:Name="ServerEncodingSettings" Orientation="Vertical" Spacing="10">
                                            <StackPanel Orientation="Horizontal">
                                                <Label Content="{Binding [SR_InputEncoding], Source={x:Static langs:LanguageManager.Instance}}" Style="{StaticResource MagicLabel14}"/>
                                                <Button x:Name="inputCmdEncoding" Content="UTF8" Click="inputCmdEncoding_Click"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Label Content="{Binding [SR_OutputEncoding], Source={x:Static langs:LanguageManager.Instance}}" Style="{StaticResource MagicLabel14}"/>
                                                <Button x:Name="outputCmdEncoding" Content="UTF8" Click="outputCmdEncoding_Click"/>
                                            </StackPanel>
                                        </hc:UniformSpacingPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Label Content="{Binding [SR_SpecialLogs], Source={x:Static langs:LanguageManager.Instance}}" Style="{StaticResource MagicLabel14}"/>
                                            <Grid Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <ToggleButton Grid.Row="0" x:Name="shieldLogBtn" Content="{Binding [SR_ShieldKeywordLog], Source={x:Static langs:LanguageManager.Instance}}" Style="{StaticResource ToggleButtonSwitch.Content}" Click="shieldLogBtn_Click"/>
                                                <ListBox x:Name="ShieldLogList" Grid.Row="1" Margin="0,5,0,5" Height="120"/>
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="5"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="LogShield_Add" Content="{Binding [SR_Add], Source={x:Static langs:LanguageManager.Instance}}" Grid.Column="0" HorizontalAlignment="Stretch" Click="LogShield_Add_Click"/>
                                                    <Button x:Name="LogShield_Del" Content="{Binding [SR_Remove], Source={x:Static langs:LanguageManager.Instance}}" Grid.Column="2" HorizontalAlignment="Stretch" Click="LogShield_Del_Click"/>
                                                </Grid>
                                            </Grid>
                                            <Grid Grid.Column="3">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <ToggleButton Grid.Row="0" x:Name="highLightLogBtn" Content="{Binding [SR_HighlightKeywordLog], Source={x:Static langs:LanguageManager.Instance}}" Style="{StaticResource ToggleButtonSwitch.Content}" Click="highLightLogBtn_Click"/>
                                                <ListBox x:Name="HighLightLogList" Grid.Row="1" Margin="0,5,0,5" Height="120"/>
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="5"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="LogHighLight_Add" Content="{Binding [SR_Add], Source={x:Static langs:LanguageManager.Instance}}" Grid.Column="0" HorizontalAlignment="Stretch" Click="LogHighLight_Add_Click"/>
                                                    <Button x:Name="LogHighLight_Del" Content="{Binding [SR_Remove], Source={x:Static langs:LanguageManager.Instance}}" Grid.Column="2" HorizontalAlignment="Stretch" Click="LogHighLight_Del_Click"/>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </hc:UniformSpacingPanel>
                                </Grid>
                                <hc:Divider Margin="0"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="{Binding [SR_OtherFeatures], Source={x:Static langs:LanguageManager.Instance}}" Grid.Column="0" Style="{StaticResource MagicLabel16}"/>
                                    <WrapPanel Grid.Column="1">
                                        <Button x:Name="onlineMode" Content="{Binding [SR_DisableOnlineMode], Source={x:Static langs:LanguageManager.Instance}}" Click="onlineMode_Click" FontSize="14" Margin="0,0,5,5"/>
                                        <Button x:Name="shareLog" Content="{Binding [SR_UploadServerLog], Source={x:Static langs:LanguageManager.Instance}}" FontSize="14" Margin="0,0,5,5" Click="shareLog_Click" MouseDoubleClick="controlServer_MouseDoubleClick"/>
                                        <Button x:Name="forgeInstallLogUpload" Content="{Binding [SR_UploadForgeLog], Source={x:Static langs:LanguageManager.Instance}}" FontSize="14" Click="forgeInstallLogUpload_Click" Margin="0,0,5,5"/>
                                        <Button x:Name="logsAnalyse" Content="{Binding [SR_AILogAnalysis], Source={x:Static langs:LanguageManager.Instance}}" FontSize="14" Click="logsAnalyse_Click" Margin="0,0,5,5"/>
                                        <Button x:Name="GetIPV6" Content="{Binding [SR_ViewIPv6], Source={x:Static langs:LanguageManager.Instance}}" FontSize="14" Click="GetIPV6_Click" Margin="0,0,5,5"/>
                                    </WrapPanel>
                                </Grid>
                            </hc:UniformSpacingPanel>
                        </controls:MagicCard>
                        <controls:MagicCard Title="{Binding [SR_QuickCmdBar], Source={x:Static langs:LanguageManager.Instance}}" x:Name="Tradition_CMDCard" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <ListBox x:Name="fastCmdList" Margin="5" Grid.Column="0" Height="160"/>
                                <StackPanel Grid.Column="1">
                                    <Button x:Name="refrushFastCmd" Content="{Binding [SR_Refresh], Source={x:Static langs:LanguageManager.Instance}}" Height="70" MinWidth="110" Padding="10,0" Click="refrushFastCmd_Click" FontSize="18" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    <Button x:Name="addFastCmd" Content="{Binding [SR_Add], Source={x:Static langs:LanguageManager.Instance}}" Margin="5" Height="40" MinWidth="110" Padding="10,0" Click="addFastCmd_Click" FontSize="18" VerticalAlignment="Top" HorizontalAlignment="Right" />
                                    <Button x:Name="delFastCmd" Content="{Binding [SR_Delete], Source={x:Static langs:LanguageManager.Instance}}" Height="40" MinWidth="110" Padding="10,0" Click="delFastCmd_Click" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,5" />
                                </StackPanel>
                                <Button Grid.Column="2" x:Name="resetFastCmd" Content="{Binding [SR_Reset], Source={x:Static langs:LanguageManager.Instance}}" MinWidth="110" Padding="10,0" Height="160" Click="resetFastCmd_Click" FontSize="18" HorizontalAlignment="Right"/>
                            </Grid>
                        </controls:MagicCard>
                    </controls:MagicScrollViewer>
                </Grid>
            </TabItem>
            <TabItem x:Name="Tab_Timer" Width="50" Style="{StaticResource TabItemSideMenu}">
                <TabItem.Header>
                    <controls:TabControlHeader IconKind="TimerOutline" Text="{Binding [SR_ScheduledTasks], Source={x:Static langs:LanguageManager.Instance}}"/>
                </TabItem.Header>
                <ScrollViewer>
                    <Grid Style="{StaticResource GridAnimation}">
                    <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 任务列表 -->
                        <controls:MagicCard Title="{Binding [SR_TaskListTitle], Source={x:Static langs:LanguageManager.Instance}}" Grid.Row="0" Margin="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ListBox Grid.Column="0" x:Name="tasksList" SelectionMode="Single" hc:Empty.ShowEmpty="true" SelectionChanged="tasksList_SelectionChanged"/>
                                <hc:UniformSpacingPanel Spacing="5" Orientation="Vertical" Grid.Column="1" MinWidth="256" Margin="5,0,0,0">
                                    <Button x:Name="addTask" Click="addTask_Click" Height="48">
                                            <Button.Content>
                                                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                                    <iconPacks:PackIconMaterial Kind="Plus" Height="14"/>
                                                    <TextBlock Text="{Binding [SR_AddNewTask], Source={x:Static langs:LanguageManager.Instance}}" FontSize="14"/>
                                                </hc:UniformSpacingPanel>
                                            </Button.Content>
                                        </Button>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="delTask" Click="delTask_Click">
                                            <Button.Content>
                                                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                                    <iconPacks:PackIconMaterial Kind="DeleteOutline" Height="14"/>
                                                    <TextBlock Text="{Binding [SR_DeleteSelectedTask], Source={x:Static langs:LanguageManager.Instance}}" FontSize="14"/>
                                                </hc:UniformSpacingPanel>
                                            </Button.Content>
                                        </Button>
                                        <Button Grid.Column="2" x:Name="delAllTask" Click="delAllTask_Click">
                                            <Button.Content>
                                                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                                    <iconPacks:PackIconMaterial Kind="Delete" Height="14"/>
                                                    <TextBlock Text="{Binding [SR_DeleteAllTasks], Source={x:Static langs:LanguageManager.Instance}}" FontSize="14"/>
                                                </hc:UniformSpacingPanel>
                                            </Button.Content>
                                        </Button>
                                    </Grid>
                                    <Button Grid.Row="2" x:Name="loadOrSaveTaskConfig" Click="LoadOrSaveTaskConfig_Click" FontSize="14" Content="{Binding [SR_LoadTaskConfig], Source={x:Static langs:LanguageManager.Instance}}" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Row="4" x:Name="delTaskConfig" Click="delTaskConfig_Click" FontSize="14" Content="{Binding [SR_ClearTaskConfig], Source={x:Static langs:LanguageManager.Instance}}" HorizontalAlignment="Stretch"/>
                                </hc:UniformSpacingPanel>
                            </Grid>
                        </controls:MagicCard>

                        <!-- 任务设置面板 -->
                        <Border x:Name="TimerTaskSettings" IsEnabled="False" Style="{StaticResource MagicBorder}" Grid.Row="1" VerticalAlignment="Bottom" Margin="10,0,10,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- Cron 表达式输入 -->
                                <Grid Grid.Row="0" Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="{Binding [SR_CronExpr], Source={x:Static langs:LanguageManager.Instance}}" FontSize="14"
                                           BorderThickness="0" Background="Transparent"/>
                                    <TextBox Grid.Column="1" x:Name="timercmdCron" FontSize="14"
                                             TextChanged="timercmdCron_TextChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="cronValidationText"
                                               VerticalAlignment="Center" Margin="8,0,0,0" Text=""/>
                                </Grid>

                                <!-- 快捷模板 -->
                                <WrapPanel Grid.Row="1" Margin="0,5,0,0" Orientation="Horizontal">
                                    <Label Content="{Binding [SR_QuickTemplate], Source={x:Static langs:LanguageManager.Instance}}" FontSize="14" VerticalAlignment="Center"
                                           BorderThickness="0" Background="Transparent"/>
                                    <Button Content="{Binding [SR_Every10Sec], Source={x:Static langs:LanguageManager.Instance}}" Margin="2"
                                            Click="CronTemplate_Click" Tag="*/10 * * * * *"/>
                                    <Button Content="{Binding [SR_EveryMin], Source={x:Static langs:LanguageManager.Instance}}" Margin="2"
                                            Click="CronTemplate_Click" Tag="0 * * * * *"/>
                                    <Button Content="{Binding [SR_Every5Min], Source={x:Static langs:LanguageManager.Instance}}" Margin="2"
                                            Click="CronTemplate_Click" Tag="0 */5 * * * *"/>
                                    <Button Content="{Binding [SR_Every30Min], Source={x:Static langs:LanguageManager.Instance}}" Margin="2"
                                            Click="CronTemplate_Click" Tag="0 */30 * * * *"/>
                                    <Button Content="{Binding [SR_EveryHour], Source={x:Static langs:LanguageManager.Instance}}" Margin="2"
                                            Click="CronTemplate_Click" Tag="0 0 * * * *"/>
                                    <Button Content="{Binding [SR_EveryDay3AM], Source={x:Static langs:LanguageManager.Instance}}" Margin="2"
                                            Click="CronTemplate_Click" Tag="0 0 3 * * *"/>
                                    <Button Content="{Binding [SR_EverySun3AM], Source={x:Static langs:LanguageManager.Instance}}" Margin="2"
                                            Click="CronTemplate_Click" Tag="0 0 3 * * 0"/>
                                </WrapPanel>

                                <!-- 指令输入 -->
                                <Grid Grid.Row="2" Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="{Binding [SR_CommandLabel], Source={x:Static langs:LanguageManager.Instance}}" FontSize="14"
                                           BorderThickness="0" Background="Transparent" Width="65"/>
                                    <TextBox Grid.Column="1" x:Name="timercmdCmd"
                                             TextChanged="timercmdCmd_TextChanged"/>
                                </Grid>

                                <Grid Grid.Row="3" Margin="0,5,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Margin="0,0,0,5" Style="{StaticResource BorderTipPrimary}">
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource DarkPrimaryBrush}"
                                                   FontSize="13" HorizontalAlignment="Left"
                                                   Text="{Binding [SR_CronFormatTip], Source={x:Static langs:LanguageManager.Instance}}">
                                        </TextBlock>
                                    </Border>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Vertical">
                                            <StackPanel Orientation="Horizontal">
                                                <Label Content="{Binding [SR_LastExec], Source={x:Static langs:LanguageManager.Instance}}" FontSize="14" BorderThickness="0" Background="Transparent"/>
                                                <TextBlock x:Name="timerCmdout" Text="{Binding [None], Source={x:Static langs:LanguageManager.Instance}}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" x:Name="startTimercmd"
                                                      Click="startTimercmd_Click" Margin="5,0,0,0">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleButton.NoCheckedBorder}">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Content">
                                                                <Setter.Value>
                                                                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="3">
                                                                        <iconPacks:PackIconMaterial Kind="Stop"/>
                                                                        <TextBlock Text="{Binding [SR_StopScheduledTask], Source={x:Static langs:LanguageManager.Instance}}" FontSize="14"/>
                                                                    </hc:UniformSpacingPanel>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="False">
                                                            <Setter Property="Content">
                                                                <Setter.Value>
                                                                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="3">
                                                                        <iconPacks:PackIconMaterial Kind="Play"/>
                                                                        <TextBlock Text="{Binding [SR_StartScheduledTask], Source={x:Static langs:LanguageManager.Instance}}" FontSize="14"/>
                                                                    </hc:UniformSpacingPanel>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Button x:Name="SideMenuContextOpen" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="50" Height="42" BorderThickness="0" Background="Transparent" Click="SideMenuContextOpen_Click">
            <Path Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="1.5">
                <Path.Data>
                    <GeometryGroup>
                        <PathGeometry Figures="M 0 0 h 15"/>
                        <PathGeometry Figures="M 0 5 h 15"/>
                        <PathGeometry Figures="M 0 10 h 15"/>
                    </GeometryGroup>
                </Path.Data>
            </Path>
        </Button>
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalAlignment="Right" VerticalAlignment="Top">
            <StackPanel Name="GrowlPanel" hc:Growl.GrowlParent="True" VerticalAlignment="Top" Margin="0,0,0,10" />
        </ScrollViewer>
    </Grid>
</hc:Window>
