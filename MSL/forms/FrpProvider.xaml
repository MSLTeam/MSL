<UserControl x:Class="MSL.FrpProvider"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:controls="clr-namespace:MSL.controls"
        xmlns:local="clr-namespace:MSL"
        xmlns:langs="clr-namespace:MSL.langs"
        mc:Ignorable="d" Template="{StaticResource UserControlTemplate1}" 
        d:Height="450" d:Width="750">
    <Grid x:Name="MainGrid">
        <Frame x:Name="frame" BorderBrush="Transparent" Margin="0,29,0,0" NavigationUIVisibility="Hidden"/>
        <TabControl x:Name="TabCtrl" Style="{StaticResource TabControlInLine}" Background="{x:Null}" BorderThickness="0,1,0,0" SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="{Binding [Form_FrpProvider_Back], Source={x:Static langs:LanguageManager.Instance}}" Background="Transparent"/>
            <TabItem Header="MSL Frp" Background="Transparent"/>
            <TabItem Header="OpenFrp" Background="Transparent"/>
            <TabItem Header="Sakura Frp" Background="Transparent"/>
            <TabItem Header="ChmlFrp" Background="Transparent"/>
            <TabItem Header="ME Frp" Background="Transparent"/>
            <TabItem Header="{Binding [Form_FrpProvider_CustomFrp], Source={x:Static langs:LanguageManager.Instance}}" Background="Transparent"/>
            <TabItem Header="{Binding [Form_FrpProvider_MoreFrp], Source={x:Static langs:LanguageManager.Instance}}" Background="Transparent">
                <Grid>
                    <hc:Card HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Margin="10" MaxWidth="500">
                            <Label Content="{Binding [Form_FrpProvider_WantMore], Source={x:Static langs:LanguageManager.Instance}}" FontWeight="Bold" BorderThickness="0" FontSize="18" Margin="0,0,0,10"/>
                            <TextBlock LineHeight="20" Text="{Binding [Form_FrpProvider_ProviderInfo], Source={x:Static langs:LanguageManager.Instance}}" FontSize="14" HorizontalAlignment="Center"/>
                            <TextBlock LineHeight="20" Text="{Binding [Form_FrpProvider_UserInfo], Source={x:Static langs:LanguageManager.Instance}}" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Margin="0,10,0,10"/>
                            <!-- <Button Content="提交接入申请" Style="{DynamicResource ButtonPrimary}" Margin="0,10,0,0" Click="JoinUs_Click"/> -->
                        </StackPanel>
                    </hc:Card>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>