<UserControl x:Class="MSL.pages.DownloadServer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:controls="clr-namespace:MSL.controls"
      xmlns:local="clr-namespace:MSL"
      xmlns:langs="clr-namespace:MSL.langs"
      Template="{StaticResource UserControlTemplate1}" 
      mc:Ignorable="d" d:Height="450" d:Width="750"
      Loaded="UserControl_Loaded">
    <Grid x:Name="MainGrid">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <hc:UniformSpacingPanel Spacing="5" Margin="10" Grid.Row="0">
                    <Button x:Name="CloseBtn" Content="{Binding [SR_Return], Source={x:Static langs:LanguageManager.Instance}}" Click="CloseBtn_Click" Height="36" FontSize="14"/>
                    <Button x:Name="RefreshBtn" Content="{Binding [SR_Refresh], Source={x:Static langs:LanguageManager.Instance}}" Click="RefreshBtn_Click" Height="36" MinWidth="72" Padding="8,0" FontSize="14"/>
                    <Button x:Name="DownloadBtn" Content="{Binding [SR_Download], Source={x:Static langs:LanguageManager.Instance}}" Style="{StaticResource ButtonPrimary}" Height="36" MinWidth="72" Padding="8,0" FontSize="14" Click="DownloadBtn_Click"/>
                    <Button x:Name="OpenDownloadManager" Content="{Binding [Form_DownloadServer_DownloadList], Source={x:Static langs:LanguageManager.Instance}}" Width="128" Height="36" Background="#33000000" FontSize="14" Click="OpenDownloadManager_Click"/>
                    <Button x:Name="openChooseServerDocs" Content="{Binding [Form_DownloadServer_Docs], Source={x:Static langs:LanguageManager.Instance}}" Width="128" Height="36" Background="#33000000" FontSize="14" Click="openChooseServerDocs_Click"/>
                    <CheckBox x:Name="UseMirrorUrl" Content="{Binding [Form_DownloadServer_UseMirror], Source={x:Static langs:LanguageManager.Instance}}" IsChecked="True"/>
                </hc:UniformSpacingPanel>
                <TextBox Grid.Row="1" x:Name="server_d" Margin="10,0,10,0" TextWrapping="Wrap" Focusable="False" IsReadOnly="True" Background="{DynamicResource RegionBrush}" FontSize="14"/>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Margin="10,5,0,0" FontSize="14" Content="{Binding [Form_DownloadServer_ServerList], Source={x:Static langs:LanguageManager.Instance}}" HorizontalAlignment="Left"/>
                    <ListView Grid.Row="1" x:Name="serverCoreList" Background="{DynamicResource RegionBrush}" Margin="10,5,3,10" FontSize="14" SelectionChanged="serverCoreList_SelectionChanged"/>
                    <TextBlock Grid.Row="1" x:Name="serverCoreLoadTip" Text="{Binding [Form_DownloadServer_Loading], Source={x:Static langs:LanguageManager.Instance}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource DarkPrimaryBrush}"/>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Margin="7,5,0,0" FontSize="14" Content="{Binding [Form_DownloadServer_VersionList], Source={x:Static langs:LanguageManager.Instance}}" HorizontalAlignment="Left"/>
                    <ListView Grid.Row="1" x:Name="coreVersionList" Background="{DynamicResource RegionBrush}" Margin="7,5,7,10" FontSize="14" SelectionMode="Single" SelectionChanged="coreVersionList_SelectionChanged"/>
                    <TextBlock Grid.Row="1" x:Name="coreVersionLoadTip" Text="{Binding [Form_DownloadServer_Loading], Source={x:Static langs:LanguageManager.Instance}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource DarkPrimaryBrush}"/>
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Margin="3,5,0,0" FontSize="14" Content="{Binding [Form_DownloadServer_BuildList], Source={x:Static langs:LanguageManager.Instance}}" HorizontalAlignment="Left"/>
                    <ListView Grid.Row="1" x:Name="versionBuildList" Background="{DynamicResource RegionBrush}" Margin="3,5,10,10" FontSize="14" SelectionMode="Single" MouseDoubleClick="versionBuildList_MouseDoubleClick"/>
                    <TextBlock Grid.Row="1" x:Name="versionBuildLoadTip" Text="{Binding [Form_DownloadServer_Loading], Source={x:Static langs:LanguageManager.Instance}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource DarkPrimaryBrush}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
