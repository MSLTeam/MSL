                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Rectangle x:Key="DownloadEmptyLogo" x:Shared="False"
                   Width="64" Height="41"
                   HorizontalAlignment="Center"
                   Fill="{StaticResource DownloadEmptyLogoBrush}" />
        <TextBlock x:Key="DownloadEmptyDescription" x:Shared="False"
                   Text="{ex:Lang Key={x:Static hcLangs:LangKeys.NoData}}"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   Margin="0,10,0,0"
                   HorizontalAlignment="Center" />
        <Style TargetType="{x:Type hc:Empty}" BasedOn="{StaticResource EmptyBaseStyle}">
            <Setter Property="Logo" Value="{StaticResource DownloadEmptyLogo}" />
            <Setter Property="Description" Value="{StaticResource DownloadEmptyDescription}" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
</UserControl>
