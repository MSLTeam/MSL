<UserControl x:Class="MSL.controls.dialogs.DownloadDisplayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MSL.controls.dialogs"
             xmlns:control="clr-namespace:MSL.controls"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:hcLangs="clr-namespace:HandyControl.Properties.Langs;assembly=HandyControl"
             xmlns:ex="clr-namespace:HandyControl.Tools.Extension;assembly=HandyControl"
             xmlns:langs="clr-namespace:MSL.langs"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <control:MagicCard Title="{Binding [SR_DownloadItem], Source={x:Static langs:LanguageManager.Instance}}" BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 下载项列表 -->
            <control:MagicListBox1 x:Name="DownloadItemsListView" hc:Empty.ShowEmpty="True" Grid.Row="0" MinHeight="100"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single" BorderThickness="0">
                <control:MagicListBox1.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 文件名和URL -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Filename}" 
                                TextTrimming="CharacterEllipsis" FontWeight="DemiBold"
                                Style="{StaticResource MagicText14}" Margin="0,0,0,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Url}" 
                                TextTrimming="CharacterEllipsis" Opacity="0.7"
                                Style="{StaticResource MagicText}" Margin="0,0,0,5"/>

                            <!-- 进度条 -->
                            <ProgressBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5"
                                Value="{Binding Progress.ProgressPercentage}" 
                                Height="15" Maximum="100"/>

                            <!-- 下载信息和状态 -->
                            <WrapPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Style="{StaticResource MagicText}" Margin="0,0,15,0">
                                    <Run Text="{Binding [SR_Speed], Source={x:Static langs:LanguageManager.Instance}, Mode=OneWay}"/><Run Text="{Binding SpeedText}"/>
                                    <Run Text="{Binding [SR_RemainingTime], Source={x:Static langs:LanguageManager.Instance}, Mode=OneWay}"/><Run Text="{Binding RemainingText}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource MagicText}" TextWrapping="Wrap"/>
                            </WrapPanel>
                        </Grid>
                    </DataTemplate>
                </control:MagicListBox1.ItemTemplate>
            </control:MagicListBox1>

            <!-- 底部控制区 -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0" Orientation="Horizontal">
                <TextBlock Text="{Binding [SR_DownloadingLabel], Source={x:Static langs:LanguageManager.Instance}}" VerticalAlignment="Center"/>
                <TextBlock x:Name="ActiveDownloadsTextBlock" Text="0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </control:MagicCard>
