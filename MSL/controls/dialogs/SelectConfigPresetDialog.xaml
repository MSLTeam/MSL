<hc:Window x:Class="MSL.controls.dialogs.SelectConfigPresetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="选择要保存的配置项"
        Width="980" Height="720" MinWidth="760" MinHeight="560"
        NonClientAreaBackground="{DynamicResource BackgroundBrush}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid x:Name="MainGrid" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Foreground="{DynamicResource PrimaryTextBrush}" Text="选择要保存的配置项" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="0" Foreground="{DynamicResource SecondaryTextBrush}" Text="勾选要保存到预设的配置项（默认全选）" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>

        <!-- 全选 / 取消全选 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10">
            <Button x:Name="selectAllBtn" Content="全选" Width="90" Click="selectAllBtn_Click"/>
            <Button x:Name="deselectAllBtn" Content="取消全选" Width="90" Margin="10,0,0,0" Click="deselectAllBtn_Click"/>
            <TextBlock x:Name="selectedCountLab" Text="已选择 0 / 0 项" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
        </StackPanel>

        <!-- 配置项列表（撑满窗口剩余空间） -->
        <Border Grid.Row="2" CornerRadius="8" Background="{DynamicResource BorderBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="itemsPanel"/>
            </ScrollViewer>
        </Border>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="PrimaryBtn" Content="保存预设" Style="{StaticResource ButtonPrimary}" Width="110" Height="34" FontSize="14" Click="PrimaryBtn_Click" Margin="0,0,10,0"/>
            <Button x:Name="CloseBtn" Content="取消" Width="90" Height="34" FontSize="14" Click="CloseBtn_Click"/>
        </StackPanel>
    </Grid>
</hc:Window>
