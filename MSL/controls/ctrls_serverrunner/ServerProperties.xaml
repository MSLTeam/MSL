<UserControl x:Class="MSL.controls.ctrls_serverrunner.ServerProperties"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:MSL.controls"
             xmlns:langs="clr-namespace:MSL.langs"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <local:MagicCard>
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="changeServerPropertiesLab" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding [SR_ServerConfig], Source={x:Static langs:LanguageManager.Instance}}"/>
                <Button x:Name="refreahServerConfig" Margin="10,0,0,0" Content="{Binding [SR_Refresh], Source={x:Static langs:LanguageManager.Instance}}" MinWidth="80" Padding="10,0" Click="refreahServerConfig_Click"/>
            </StackPanel>
            <Grid>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                    </Style>
                </Grid.Resources>
                <Rectangle RadiusX="10" RadiusY="10" Stroke="{DynamicResource BorderBrush}" Fill="{DynamicResource BorderBackground}" Height="115"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding [SR_GameModeDesc], Source={x:Static langs:LanguageManager.Instance}}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding [SR_GameDiffDesc], Source={x:Static langs:LanguageManager.Instance}}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>
                </Grid>
                <Rectangle Height="1" Stroke="{DynamicResource BorderBrush}" Margin="0,30,0,0" VerticalAlignment="Top"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="3" Stroke="{DynamicResource BorderBrush}" Width="1" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="0" TextWrapping="Wrap" Text="{Binding [SR_Survival], Source={x:Static langs:LanguageManager.Instance}}" Margin="0,40,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding [SR_Creative], Source={x:Static langs:LanguageManager.Instance}}" Margin="0,40,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="2" TextWrapping="Wrap" Text="{Binding [SR_Adventure], Source={x:Static langs:LanguageManager.Instance}}" Margin="0,40,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="3" TextWrapping="Wrap" Text="{Binding [SR_Spectator], Source={x:Static langs:LanguageManager.Instance}}" Margin="0,40,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="4" TextWrapping="Wrap" Text="{Binding [SR_Peaceful], Source={x:Static langs:LanguageManager.Instance}}" Margin="0,40,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="5" TextWrapping="Wrap" Text="{Binding [SR_Easy], Source={x:Static langs:LanguageManager.Instance}}" Margin="0,40,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="6" TextWrapping="Wrap" Text="{Binding [SR_Normal], Source={x:Static langs:LanguageManager.Instance}}" Margin="0,40,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="7" TextWrapping="Wrap" Text="{Binding [SR_Hard], Source={x:Static langs:LanguageManager.Instance}}" Margin="0,40,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="0" TextWrapping="Wrap" Text="Survival" Margin="0,65,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="Creative" Margin="0,65,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="2" TextWrapping="Wrap" Text="Adventure" Margin="0,65,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="3" TextWrapping="Wrap" Text="Spectator" Margin="0,65,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="4" TextWrapping="Wrap" Text="Peaceful" Margin="0,65,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="5" TextWrapping="Wrap" Text="Easy" Margin="0,65,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="6" TextWrapping="Wrap" Text="Normal" Margin="0,65,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="7" TextWrapping="Wrap" Text="Hard" Margin="0,65,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="0" Margin="0,90,0,0" TextWrapping="Wrap" Text="0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="1" Margin="0,90,0,0" TextWrapping="Wrap" Text="1" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="2" Margin="0,90,0,0" TextWrapping="Wrap" Text="2" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="3" Margin="0,90,0,0" TextWrapping="Wrap" Text="3" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="4" Margin="0,90,0,0" TextWrapping="Wrap" Text="0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="5" Margin="0,90,0,0" TextWrapping="Wrap" Text="1" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="6" Margin="0,90,0,0" TextWrapping="Wrap" Text="2" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="7" Margin="0,90,0,0" TextWrapping="Wrap" Text="3" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                </Grid>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="配置预设：" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Margin="8,0,5,0" MinHeight="34" MaxHeight="76"
                        Padding="5,3" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Background="{DynamicResource BorderBackground}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="ConfigPresetButtonsPanel" VerticalAlignment="Center"/>
                    </ScrollViewer>
                </Border>
                <Button x:Name="LoadSelectedConfigPresetButton" Grid.Column="2" Content="加载预设" MinWidth="90" Padding="10,0"
                        IsEnabled="False"
                        Margin="0,0,5,0" Click="LoadConfigPreset_Click"/>
                <Button x:Name="configPresetButton" Grid.Column="3" Content="添加预设" MinWidth="90" Padding="10,0"
                        IsEnabled="False"
                        Click="configPresetButton_Click"/>
            </Grid>
            <TextBlock x:Name="ConfigPresetStatusText" Visibility="Collapsed"
                       Foreground="{DynamicResource DarkPrimaryBrush}" TextWrapping="Wrap"/>
            <Border x:Name="ConfigPresetPanel" Visibility="Collapsed" Padding="10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                    Background="{DynamicResource BorderBackground}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="功能配置文件预设" Style="{StaticResource MagicText16}" FontWeight="Bold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="功能配置文件预设"/>
                        <hc:UniformSpacingPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                            <Button Content="全选" Click="SelectAllConfigPreset_Click"/>
                            <Button Content="全不选" Click="SelectNoneConfigPreset_Click"/>
                            <Button Content="收起" Click="CollapseConfigPreset_Click"/>
                        </hc:UniformSpacingPanel>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1*" MinWidth="180"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="2,0,2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="保存" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="配置项" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Text="配置值"/>
                            </Grid>
                            <ListView x:Name="ConfigPresetList" Grid.Row="1" MinHeight="150" MaxHeight="400"
                                      VerticalAlignment="Top" HorizontalContentAlignment="Stretch"
                                      ItemsSource="{Binding ConfigPresetItems, ElementName=Root}"
                                      BorderThickness="0" Background="{DynamicResource ContentRegionBrush}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      PreviewMouseLeftButtonDown="ConfigPresetList_PreviewMouseLeftButtonDown">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="IsTabStop" Value="False"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="3*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Key}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Key}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Value}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Value}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                        <hc:UniformSpacingPanel Grid.Column="2" Orientation="Vertical" Spacing="8">
                            <TextBlock Text="预设名称" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBox x:Name="ConfigPresetNameTextBox" Height="30" VerticalContentAlignment="Center"/>
                            <Button x:Name="SaveConfigPresetButton" Content="保存预设" Style="{StaticResource ButtonPrimary}"
                                    Click="SaveConfigPreset_Click" Visibility="Collapsed"/>
                            <Button x:Name="ApplyConfigPresetButton" Content="应用预设"
                                    Style="{StaticResource ButtonPrimary}" Click="ApplyConfigPreset_Click"
                                    Visibility="Collapsed"/>
                            <Button x:Name="DeleteConfigPresetButton" Content="删除预设"
                                    Click="DeleteConfigPreset_Click" Visibility="Collapsed"/>
                        </hc:UniformSpacingPanel>
                    </Grid>
                </Grid>
            </Border>
            <Grid x:Name="ChangeServerProperties">
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                    </Style>
                    <Style TargetType="Label" BasedOn="{StaticResource MagicLabel14}"/>
                </Grid.Resources>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button x:Name="saveServerConfig" Grid.Column="0" Style="{StaticResource ButtonPrimary}" Content="{Binding [SR_Save], Source={x:Static langs:LanguageManager.Instance}}" Height="35" Click="saveServerConfig_Click" FontSize="14" HorizontalAlignment="Stretch" Margin="10,0,10,0"/>
                <Button x:Name="changeServerIcon" Grid.Column="1" Content="{Binding [SR_ChangeServerIcon], Source={x:Static langs:LanguageManager.Instance}}" Height="35" FontSize="14" Click="changeServerIcon_Click" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="10,0,10,0"/>
                <Button x:Name="changeWorldMap" Grid.Column="2" Content="{Binding [SR_ChangeWorldMap], Source={x:Static langs:LanguageManager.Instance}}" Click="changeWorldMap_Click" Height="35" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="10,0,10,0"/>
                <Button x:Name="setServerconfig" Grid.Column="3" Content="{Binding [SR_MoreConfig], Source={x:Static langs:LanguageManager.Instance}}" Height="35" FontSize="14" Click="setServerconfig_Click" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="10,0,10,0"/>
            </Grid>
        </hc:UniformSpacingPanel>
    </local:MagicCard>
</UserControl>
