<UserControl x:Class="MSL.pages.frpProviders.MSLFrp.MSLFrpLogin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MSL.pages.frpProviders.MSLFrp"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:controls="clr-namespace:MSL.controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:langs="clr-namespace:MSL.langs"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid x:Name="LoginGrid" Visibility="Visible">
            <controls:MagicCard Margin="10">
                <hc:UniformSpacingPanel Spacing="20" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" ItemHorizontalAlignment="Center" >
                    <Image Source="/images/msl-user-msl-user-logo-512-transparent-BjXu1GPW.png" 
Width="80" 
Height="80" 
HorizontalAlignment="Center"
RenderOptions.BitmapScalingMode="HighQuality"
Margin="0,0,0,-5"/>
                    <TextBlock Text="{Binding [Frp_MSLFrpLogin_Welcome], Source={x:Static langs:LanguageManager.Instance}}" Style="{StaticResource MagicText16}" FontWeight="Bold"/>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding [Frp_MSLFrpLogin_Email], Source={x:Static langs:LanguageManager.Instance}}" Style="{StaticResource MagicText14}" VerticalAlignment="Center"/>
                            <TextBox x:Name="UserAccount" Width="200" Margin="5,0,0,0" PreviewKeyUp="UserAccount_PreviewKeyUp"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding [Frp_MSLFrpLogin_Password], Source={x:Static langs:LanguageManager.Instance}}" Style="{StaticResource MagicText14}" VerticalAlignment="Center"/>
                            <hc:PasswordBox x:Name="UserPassword" Width="200" Margin="5,0,0,0" ShowEyeButton="True" PreviewKeyUp="UserPassword_PreviewKeyUp"/>
                        </StackPanel>
                    </hc:UniformSpacingPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BrowserLoginButton" Style="{StaticResource ButtonPrimary}" Margin="0,0,5,0" Click="BrowserLoginButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Web" VerticalAlignment="Center" Margin="0,0,5,0" Width="14" Height="14"/>
                                <TextBlock Text="{Binding [Frp_MSLFrpLogin_BrowserLogin], Source={x:Static langs:LanguageManager.Instance}}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="WechatLoginButton" Style="{StaticResource ButtonPrimary}" Margin="0,0,5,0" Click="WechatLoginButton_Click" Background="#07C160" BorderBrush="#07C160" Foreground="White">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Wechat" VerticalAlignment="Center" Margin="0,0,5,0" Width="14" Height="14"/>
                                <TextBlock Text="{Binding [Frp_MSLFrpLogin_WechatLogin], Source={x:Static langs:LanguageManager.Instance}}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Visibility="Collapsed" x:Name="UserLogin" Content="{Binding [Frp_MSLFrpLogin_Login], Source={x:Static langs:LanguageManager.Instance}}" Width="100" Style="{StaticResource ButtonPrimary}"  Margin="0,0,5,0" Click="UserLogin_Click"/>
                        <Button x:Name="userRegister" Width="130" Margin="0,0,0,0" Command="hc:ControlCommands.OpenLink" CommandParameter="https://user.mslmc.cn">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="AccountOutline" VerticalAlignment="Center" Margin="0,0,5,0" Width="14" Height="14"/>
                                <TextBlock Text="{Binding [Frp_MSLFrpLogin_Register], Source={x:Static langs:LanguageManager.Instance}}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <CheckBox Content="{Binding [Frp_MSLFrpLogin_SaveToken], Source={x:Static langs:LanguageManager.Instance}}" HorizontalAlignment="Center" x:Name="SaveToken"/>
                    <TextBlock Text="{Binding [Frp_MSLFrpLogin_ServiceDesc], Source={x:Static langs:LanguageManager.Instance}}" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center"  FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,10,0,0"/>
                </hc:UniformSpacingPanel>
            </controls:MagicCard>
        </Grid>
        <Grid x:Name="Auth2FAGrid" Visibility="Collapsed">
            <controls:MagicCard Margin="10">
                <hc:UniformSpacingPanel Spacing="20" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" ItemHorizontalAlignment="Center" >
                    <TextBlock Text="{Binding [Frp_MSLFrpLogin_2FA], Source={x:Static langs:LanguageManager.Instance}}" Style="{StaticResource MagicText16}" FontWeight="Bold"/>
                    <TextBlock x:Name="Auth2FARemark" Text="{Binding [Frp_MSLFrpLogin_2FAEmail], Source={x:Static langs:LanguageManager.Instance}}" Style="{StaticResource MagicText16}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding [Frp_MSLFrpLogin_2FACode], Source={x:Static langs:LanguageManager.Instance}}" Style="{StaticResource MagicText14}" VerticalAlignment="Center"/>
                        <TextBox x:Name="Auth2FACode" Width="200" Margin="5,0,0,0" PreviewKeyUp="Auth2FACode_PreviewKeyUp"/>
                        <Button x:Name="Auth2FAResend" Content="{Binding [Frp_MSLFrpLogin_Resend], Source={x:Static langs:LanguageManager.Instance}}" MinWidth="100" Margin="5,0,0,0" Click="Auth2FAResend_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="User2FAReturn" Content="{Binding [Form_FrpProvider_Back], Source={x:Static langs:LanguageManager.Instance}}" Width="100" Margin="0,0,5,0" Click="User2FAReturn_Click"/>
                        <Button x:Name="User2FALogin" Content="{Binding [OK], Source={x:Static langs:LanguageManager.Instance}}" Width="100" Style="{StaticResource ButtonPrimary}"  Margin="5,0,0,0" Click="User2FALogin_Click"/>
                    </StackPanel>
                </hc:UniformSpacingPanel>
            </controls:MagicCard>
        </Grid>

        <Grid x:Name="BrowserLoginGrid" Visibility="Collapsed">
            <controls:MagicCard Margin="10">
                <hc:UniformSpacingPanel Spacing="20" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" ItemHorizontalAlignment="Center" >
                    
                    <TextBlock Text="{Binding [Frp_MSLFrpLogin_BrowserLoginTitle], Source={x:Static langs:LanguageManager.Instance}}" Style="{StaticResource MagicText16}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding [Frp_MSLFrpLogin_BrowserLoginDesc], Source={x:Static langs:LanguageManager.Instance}}" Style="{StaticResource MagicText14}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>

                    <hc:LoadingCircle Style="{StaticResource LoadingCircleLarge}" Margin="0,10,0,0"/>

                    <TextBlock Text="{Binding [Frp_MSLFrpLogin_BrowserLoginWait], Source={x:Static langs:LanguageManager.Instance}}" Style="{StaticResource MagicText14}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <Button Content="{Binding [Frp_MSLFrpLogin_ReopenBrowser], Source={x:Static langs:LanguageManager.Instance}}" Width="100" Margin="0,0,5,0" Click="ReopenBrowserButton_Click"/>
                        <Button Content="{Binding [Frp_MSLFrpLogin_CopyLink], Source={x:Static langs:LanguageManager.Instance}}" Width="100" Margin="5,0,0,0" Click="CopyBrowserLinkButton_Click"/>
                    </StackPanel>
                    <Button x:Name="CancelBrowserLoginButton" Content="{Binding [Frp_MSLFrpLogin_Cancel], Source={x:Static langs:LanguageManager.Instance}}" Width="100" Margin="0,5,0,0" Click="CancelBrowserLoginButton_Click" Style="{StaticResource ButtonDanger}"/>
                </hc:UniformSpacingPanel>
            </controls:MagicCard>
        </Grid>

        <Grid x:Name="WechatLoginGrid" Visibility="Collapsed">
            <controls:MagicCard Margin="10">
                <hc:UniformSpacingPanel Spacing="20" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" ItemHorizontalAlignment="Center" >
                    <TextBlock Text="{Binding [Frp_MSLFrpLogin_WechatTitle], Source={x:Static langs:LanguageManager.Instance}}" Style="{StaticResource MagicText16}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding [Frp_MSLFrpLogin_WechatDesc], Source={x:Static langs:LanguageManager.Instance}}" Style="{StaticResource MagicText14}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="{Binding [Frp_MSLFrpLogin_WechatBind], Source={x:Static langs:LanguageManager.Instance}}" FontSize="12" Foreground="Gray" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,-15,0,0"/>

                    <Image x:Name="WechatQrCodeImage" Width="172" Height="172" Margin="0,10,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>

                    <hc:LoadingCircle x:Name="WechatLoadingCircle" Style="{StaticResource LoadingCircleLarge}" Margin="0,10,0,0" Visibility="Collapsed"/>
                    
                    <TextBlock x:Name="WechatLoginStatusText" Text="{Binding [Frp_MSLFrpLogin_Loading], Source={x:Static langs:LanguageManager.Instance}}" Style="{StaticResource MagicText14}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>

                    <Button x:Name="CancelWechatLoginButton" Content="{Binding [Frp_MSLFrpLogin_Cancel], Source={x:Static langs:LanguageManager.Instance}}" Width="100" Margin="0,5,0,0" Click="CancelWechatLoginButton_Click" Style="{StaticResource ButtonDanger}"/>
                </hc:UniformSpacingPanel>
            </controls:MagicCard>
        </Grid>
    </Grid>
</UserControl>