<UserControl x:Class="MSL.pages.serverrunner.SRTimerTasks"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:controls="clr-namespace:MSL.controls"
        xmlns:langs="clr-namespace:MSL.langs"
        xmlns:local="clr-namespace:MSL" Style="{StaticResource AnimationControl}"
        mc:Ignorable="d">
    <ScrollViewer>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 任务列表 -->
            <controls:MagicCard Title="{Binding [SR_TaskListTitle], Source={x:Static langs:LanguageManager.Instance}}" Grid.Row="0" Margin="5,10,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0" x:Name="tasksList" SelectionMode="Single" hc:Empty.ShowEmpty="true" SelectionChanged="tasksList_SelectionChanged"/>
                    <hc:UniformSpacingPanel Spacing="5" Orientation="Vertical" Grid.Column="1" MinWidth="256" Margin="5,0,0,0">
                        <Button x:Name="addTask" Click="addTask_Click" Height="48">
                            <Button.Content>
                                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                    <iconPacks:PackIconMaterial Kind="Plus" Height="14"/>
                                    <TextBlock Text="{Binding [SR_AddNewTask], Source={x:Static langs:LanguageManager.Instance}}" FontSize="14"/>
                                </hc:UniformSpacingPanel>
                            </Button.Content>
                        </Button>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="delTask" Click="delTask_Click">
                                <Button.Content>
                                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                        <iconPacks:PackIconMaterial Kind="DeleteOutline" Height="14"/>
                                        <TextBlock Text="{Binding [SR_DeleteSelectedTask], Source={x:Static langs:LanguageManager.Instance}}" FontSize="14"/>
                                    </hc:UniformSpacingPanel>
                                </Button.Content>
                            </Button>
                            <Button Grid.Column="2" x:Name="delAllTask" Click="delAllTask_Click">
                                <Button.Content>
                                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                        <iconPacks:PackIconMaterial Kind="Delete" Height="14"/>
                                        <TextBlock Text="{Binding [SR_DeleteAllTasks], Source={x:Static langs:LanguageManager.Instance}}" FontSize="14"/>
                                    </hc:UniformSpacingPanel>
                                </Button.Content>
                            </Button>
                        </Grid>
                        <Button Grid.Row="2" x:Name="loadOrSaveTaskConfig" Click="LoadOrSaveTaskConfig_Click" FontSize="14" Content="{Binding [SR_LoadTaskConfig], Source={x:Static langs:LanguageManager.Instance}}" HorizontalAlignment="Stretch"/>
                        <Button Grid.Row="4" x:Name="delTaskConfig" Click="delTaskConfig_Click" FontSize="14" Content="{Binding [SR_ClearTaskConfig], Source={x:Static langs:LanguageManager.Instance}}" HorizontalAlignment="Stretch"/>
                    </hc:UniformSpacingPanel>
                </Grid>
            </controls:MagicCard>

            <!-- 任务设置面板 -->
            <Border x:Name="TimerTaskSettings" IsEnabled="False" Style="{StaticResource MagicBorder}" Grid.Row="1" VerticalAlignment="Bottom" Margin="5,5,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Cron 表达式输入 -->
                    <Grid Grid.Row="0" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="{Binding [SR_CronExpr], Source={x:Static langs:LanguageManager.Instance}}" FontSize="14"
                               BorderThickness="0" Background="Transparent"/>
                        <TextBox Grid.Column="1" x:Name="timercmdCron" FontSize="14"
                                 TextChanged="timercmdCron_TextChanged"/>
                        <TextBlock Grid.Column="2" x:Name="cronValidationText"
                                   VerticalAlignment="Center" Margin="8,0,0,0" Text=""/>
                    </Grid>

                    <!-- 快捷模板 -->
                    <WrapPanel Grid.Row="1" Margin="0,5,0,0" Orientation="Horizontal">
                        <Label Content="{Binding [SR_QuickTemplate], Source={x:Static langs:LanguageManager.Instance}}" FontSize="14" VerticalAlignment="Center"
                               BorderThickness="0" Background="Transparent"/>
                        <Button Content="{Binding [SR_Every10Sec], Source={x:Static langs:LanguageManager.Instance}}" Margin="2"
                                Click="CronTemplate_Click" Tag="*/10 * * * * *"/>
                        <Button Content="{Binding [SR_EveryMin], Source={x:Static langs:LanguageManager.Instance}}" Margin="2"
                                Click="CronTemplate_Click" Tag="0 * * * * *"/>
                        <Button Content="{Binding [SR_Every5Min], Source={x:Static langs:LanguageManager.Instance}}" Margin="2"
                                Click="CronTemplate_Click" Tag="0 */5 * * * *"/>
                        <Button Content="{Binding [SR_Every30Min], Source={x:Static langs:LanguageManager.Instance}}" Margin="2"
                                Click="CronTemplate_Click" Tag="0 */30 * * * *"/>
                        <Button Content="{Binding [SR_EveryHour], Source={x:Static langs:LanguageManager.Instance}}" Margin="2"
                                Click="CronTemplate_Click" Tag="0 0 * * * *"/>
                        <Button Content="{Binding [SR_EveryDay3AM], Source={x:Static langs:LanguageManager.Instance}}" Margin="2"
                                Click="CronTemplate_Click" Tag="0 0 3 * * *"/>
                        <Button Content="{Binding [SR_EverySun3AM], Source={x:Static langs:LanguageManager.Instance}}" Margin="2"
                                Click="CronTemplate_Click" Tag="0 0 3 * * 0"/>
                    </WrapPanel>

                    <!-- 指令输入 -->
                    <Grid Grid.Row="2" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="{Binding [SR_CommandLabel], Source={x:Static langs:LanguageManager.Instance}}" FontSize="14"
                               BorderThickness="0" Background="Transparent" Width="65"/>
                        <TextBox Grid.Column="1" x:Name="timercmdCmd"
                                 TextChanged="timercmdCmd_TextChanged"/>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,5,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Margin="0,0,0,5" Style="{StaticResource BorderTipPrimary}">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource DarkPrimaryBrush}"
                                       FontSize="13" HorizontalAlignment="Left"
                                       Text="{Binding [SR_CronFormatTip], Source={x:Static langs:LanguageManager.Instance}}">
                            </TextBlock>
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="{Binding [SR_LastExec], Source={x:Static langs:LanguageManager.Instance}}" FontSize="14" BorderThickness="0" Background="Transparent"/>
                                    <TextBlock x:Name="timerCmdout" Text="{Binding [None], Source={x:Static langs:LanguageManager.Instance}}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="startTimercmd"
                                          Click="startTimercmd_Click" Margin="5,0,0,0">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleButton.NoCheckedBorder}">
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="3">
                                                            <iconPacks:PackIconMaterial Kind="Stop"/>
                                                            <TextBlock Text="{Binding [SR_StopScheduledTask], Source={x:Static langs:LanguageManager.Instance}}" FontSize="14"/>
                                                        </hc:UniformSpacingPanel>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="3">
                                                            <iconPacks:PackIconMaterial Kind="Play"/>
                                                            <TextBlock Text="{Binding [SR_StartScheduledTask], Source={x:Static langs:LanguageManager.Instance}}" FontSize="14"/>
                                                        </hc:UniformSpacingPanel>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
